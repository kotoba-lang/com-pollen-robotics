{
  "schemaVersion": "1.0",
  "handle": "pollen_robotics-compat",
  "did": "did:web:etzhayyim.com:actor:pollen_robotics-compat",
  "kind": "compat",
  "title": "Pollen Robotics (Reachy 2) clean-room actor",
  "description": "Clean-room, API-compatible actor for the Pollen Robotics Reachy 2 developer SDK; policy and bookkeeping, not control. Runs browser-local on IPFS + kotoba-WASM.",
  "runtime": "kotoba-wasm",
  "exec": "browser-local|donated-mesh",
  "schema": "schema/pollen_robotics.kotoba",
  "cores": [
    {
      "name": "reachy-lidar-safety-core",
      "source": "cores/reachy_lidar_safety_core.cljk",
      "decides": "LidarObstacleDetectionEnum classification and the surviving base-speed scale",
      "upstream": "protos/mobile_base_lidar.proto"
    },
    {
      "name": "reachy-goto-core",
      "source": "cores/reachy_goto_core.cljk",
      "decides": "goto admission and the GoalStatus lifecycle",
      "upstream": "protos/goto.proto"
    }
  ],
  "tier": "L5",
  "verified": {
    "source": "https://github.com/pollen-robotics/reachy2-sdk-api",
    "docs": "https://docs.pollen-robotics.com/",
    "verifiedAt": "2026-08-28",
    "protos": [
      "arm.proto",
      "component.proto",
      "dynamixel_motor.proto",
      "error.proto",
      "goto.proto",
      "hand.proto",
      "head.proto",
      "kinematics.proto",
      "mobile_base_lidar.proto",
      "mobile_base_mobility.proto",
      "mobile_base_utility.proto",
      "orbita2d.proto",
      "orbita3d.proto",
      "parallel_gripper.proto",
      "part.proto",
      "reachy.proto",
      "video.proto",
      "webrtc_bridge.proto"
    ],
    "resources": [
      "ReachyInfo",
      "Part",
      "ArmJointState",
      "JointLimit",
      "EndEffectorPose",
      "NeckOrientation",
      "AntennaState",
      "HandState",
      "GoToRequest",
      "MobileBaseState",
      "LidarSafety",
      "CameraFeature"
    ],
    "enums": {
      "ArmJoints": [
        "SHOULDER_PITCH",
        "SHOULDER_ROLL",
        "ELBOW_YAW",
        "ELBOW_PITCH",
        "WRIST_ROLL",
        "WRIST_PITCH",
        "WRIST_YAW"
      ],
      "NeckJoints": [
        "ROLL",
        "PITCH",
        "YAW"
      ],
      "InterpolationMode": [
        "NONE_INTERPOLATION",
        "LINEAR",
        "MINIMUM_JERK"
      ],
      "GoalStatus": [
        "NONE",
        "STATUS_UNKNOWN",
        "STATUS_ACCEPTED",
        "STATUS_EXECUTING",
        "STATUS_CANCELING",
        "STATUS_SUCCEEDED",
        "STATUS_CANCELED",
        "STATUS_ABORTED"
      ],
      "LidarObstacleDetectionEnum": [
        "DETECTION_ERROR",
        "NO_OBJECT_DETECTED",
        "OBJECT_DETECTED_SLOWDOWN",
        "OBJECT_DETECTED_STOP"
      ],
      "ZuuuModePossiblities": [
        "NONE_ZUUU_MODE",
        "CMD_VEL",
        "BRAKE",
        "FREE_WHEEL",
        "SPEED",
        "GOTO",
        "EMERGENCY_STOP",
        "CMD_GOTO"
      ],
      "ControlModePossiblities": [
        "NONE_CONTROL_MODE",
        "OPEN_LOOP",
        "PID"
      ]
    },
    "parts": [
      "l_arm",
      "r_arm",
      "head",
      "l_hand",
      "r_hand",
      "mobile_base"
    ],
    "notReproduced": [
      "upstream source code",
      "generated protobuf/gRPC stubs",
      "joint limits (the robot reports its own)",
      "inverse kinematics",
      "video/audio payloads"
    ]
  },
  "entities": [
    "ReachyInfo",
    "Part",
    "ArmJointState",
    "JointLimit",
    "EndEffectorPose",
    "NeckOrientation",
    "AntennaState",
    "HandState",
    "GoToRequest",
    "MobileBaseState",
    "LidarSafety",
    "CameraFeature"
  ],
  "units": {
    "angle": "degrees at the surface, integer millidegrees in the decision cores",
    "distance": "metres at the surface, integer millimetres in the decision cores",
    "duration": "seconds at the surface, integer milliseconds in the decision cores",
    "rationale": "a limit check that decides whether a motor moves must not depend on which backend rounded the compare"
  },
  "governor": {
    "repo": "kotoba-lang/robotics",
    "note": "this actor proposes; the governor gates. governed-speed-scale-permille is the gate's input, deliberately stricter than the robot's own sdk-speed-scale-permille."
  },
